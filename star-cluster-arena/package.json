{
  "name": "star-cluster-arena",
  "productName": "星团大作战",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "十模式共享玩法，支持单人、局域网与自部署互联网联机的星域吞噬竞技游戏",
  "license": "MIT",
  "author": "Star Cluster Arena",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangzifan396-wzf/mini-browser-games.git",
    "directory": "star-cluster-arena"
  },
  "keywords": [
    "browser-game",
    "multiplayer",
    "websocket",
    "electron",
    "webgl2",
    "arena"
  ],
  "scripts": {
    "start": "node backend/server.mjs",
    "dev": "node --watch backend/server.mjs",
    "check": "node scripts/check-project.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "test:lan-harness": "node scripts/dual-lan-harness.mjs",
    "test:soak": "node scripts/multiplayer-soak.mjs",
    "test:desktop-display": "node scripts/desktop-display-smoke.mjs",
    "test:desktop-navigation": "node scripts/desktop-navigation-smoke.mjs",
    "test:desktop-release": "node scripts/desktop-release-smoke.mjs",
    "test:desktop-readiness": "node scripts/desktop-readiness-suite.mjs",
    "test:desktop-modes": "node scripts/desktop-mode-suite.mjs",
    "test:desktop-visual": "node scripts/desktop-visual-suite.mjs",
    "test:desktop-perf": "node scripts/desktop-performance-smoke.mjs",
    "test:desktop-multiplayer-perf": "node scripts/desktop-multiplayer-performance-smoke.mjs",
    "desktop": "electron-forge start",
    "package:desktop": "electron-forge package",
    "make:desktop": "electron-builder --config desktop/electron-builder.yml --win nsis zip --x64 && node scripts/organize-desktop-artifacts.mjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true
  },
  "config": {
    "forge": "./desktop/forge.config.mjs"
  }
}
